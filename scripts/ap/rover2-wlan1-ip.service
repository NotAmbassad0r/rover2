[Unit]
Description=ROVER2 AP static IP for wlan1
Before=hostapd.service dnsmasq.service
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/ip link set wlan1 up
ExecStart=/sbin/ip addr add 10.0.0.1/24 dev wlan1
ExecStop=/sbin/ip addr del 10.0.0.1/24 dev wlan1 || true

[Install]
WantedBy=multi-user.target
